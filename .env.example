# CarbonLedger OS Production & Local Environment Variables

# Frontend Configuration (Render Static Site / Vite)
VITE_API_BASE_URL=https://carbonledger-api-8bl2.onrender.com

# Backend Configuration (Render Web Service)
PORT=8000
FRONTEND_URL=https://carbonledger-app-vxb3.onrender.com
JWT_SECRET=carbonledger_enterprise_jwt_secret_key_2026
JWT_ALGORITHM=HS256
ENVIRONMENT=production

# Core AI & LLM Providers (Optional for local pipelines)
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Database Connections (SQLite used by default in production / optional PostgreSQL)
DATABASE_URL=sqlite:///carbonledger.db

# SaaS Billing & Secrets (Optional)
STRIPE_SECRET_KEY=sk_test_yourstripesecretkey

# SMTP Alerts & Emails (Optional)
SMTP_SERVER=smtp.carbonledger.com
SMTP_PORT=587
SMTP_USER=alerts@carbonledger.com
SMTP_PASSWORD=yoursmtppassword

# Webhooks & Integrations (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/X00
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-teams-endpoint
