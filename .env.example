# CarbonLedger SaaS Configuration
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Database Connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbonledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carbonledger
REDIS_URL=redis://localhost:6379/0
CHROMADB_PATH=d:/internship/carbonledger/vector_db/chroma_data

# SaaS Billing & Secrets
JWT_SECRET=your-jwt-signing-secret-key-change-in-production
STRIPE_SECRET_KEY=sk_test_yourstripesecretkey

# SMTP Alerts & Emails
SMTP_SERVER=smtp.carbonledger.com
SMTP_PORT=587
SMTP_USER=alerts@carbonledger.com
SMTP_PASSWORD=yoursmtppassword

# Webhooks & Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/X00
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-teams-endpoint
